# .openapi-generator-ignore
#
# See https://openapi-generator.tech/docs/customization/#ignore-file-format
# Tells openapi-generator NOT to write listed paths on regen.
# Each pattern is .gitignore-style.

# ----------------------------------------------------------------------
# Custom files — never overwrite on regeneration
# ----------------------------------------------------------------------
README.md
pyproject.toml
.gitignore
.travis.yml
.gitlab-ci.yml
setup.py
setup.cfg
tox.ini

# ----------------------------------------------------------------------
# Pre-existing — added in Phase 3b regen:
# ----------------------------------------------------------------------
# CI workflows are repo-controlled, not generator-controlled.
# Generator would emit a default python.yml that overwrites the
# existing test.yml / publish.yml workflows.
.github/workflows/publish.yml
.github/workflows/test.yml
.github/workflows/python.yml

# ----------------------------------------------------------------------
# Orphan prevention (Session 4 follow-up):
# ----------------------------------------------------------------------
# The generator emits files for every tag in the OpenAPI spec.
# The 'Astrology0' / 'Reports' module names came from removed tags
# but the generator can recreate them if either the spec contains
# a stray reference or the generator's internal templates re-emit
# them. These ignores guarantee neither comes back.
#
# F-40 — astrology0_api.py: legacy duplicate of astrology_api.py.
asterwise/api/astrology0_api.py
docs/Astrology0Api.md
test/test_astrology0_api.py

# F-41 — reports_api.py family: removed in v0.1.4.
asterwise/api/reports_api.py
docs/ReportsApi.md
test/test_reports_api.py
